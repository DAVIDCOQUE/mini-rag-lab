# --- Aplicacion ---
PROJECT_NAME=Mini RAG Lab
VERSION=1.0.0
DEBUG=True
API_PREFIX=/api

# --- Servidor (uvicorn) ---
HOST=127.0.0.1
PORT=8000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mini_rag_lab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# --- Ollama ---
# IP y no "localhost": en Windows, localhost resuelve primero a IPv6 y Ollama solo
# escucha en IPv4, asi que cada peticion espera ~2 s a que falle el intento.
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# --- Reranking (cross-encoder via FastEmbed) ---
RERANK_ENABLED=True
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANK_CANDIDATES=20

# --- Almacenamiento de documentos ---
STORAGE_DIR=storage
MAX_UPLOAD_MB=20

# --- Procesamiento / chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- CORS: origenes del frontend Angular (formato JSON) ---
BACKEND_CORS_ORIGINS=["http://localhost:4200"]
