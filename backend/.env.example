# --- Aplicacion ---
PROJECT_NAME=Sara
VERSION=1.0.0
# True imprime cada consulta SQL: solo para depurar.
DEBUG=False
API_PREFIX=/api

# --- Acceso al mantenedor ---
# Generar con `python -m scripts.hash_password` desde backend/. Vacio = mantenedor abierto.
ADMIN_PASSWORD_HASH=
# Firma de las sesiones: una cadena larga y fija. Vacio = reiniciar cierra las sesiones.
AUTH_SECRET=
AUTH_TOKEN_TTL_HOURS=8
# Opcional: si se define, Unity debe enviar la cabecera X-Kiosk-Key con este valor.
KIOSK_API_KEY=
CHAT_RATE_LIMIT_PER_MINUTE=20

# --- Servidor (uvicorn) ---
HOST=127.0.0.1
PORT=8000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mini_rag_lab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Qdrant ---
# IP y no "localhost", por el mismo motivo que OLLAMA_URL: en Windows cada conexion
# nueva espera ~2 s a que falle el intento por IPv6 antes de reintentar por IPv4.
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# --- Ollama ---
# IP y no "localhost": en Windows, localhost resuelve primero a IPv6 y Ollama solo
# escucha en IPv4, asi que cada peticion espera ~2 s a que falle el intento.
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
# Ventana de contexto del LLM. 16384 cabe en una GPU de 12 GB junto a bge-m3; con menos
# memoria de video hay que bajarla, o Ollama expulsa un modelo y lo relee en cada consulta.
LLM_NUM_CTX=16384

# --- Router de consultas ---
# llm: el modelo elige camino y reescribe los seguimientos (~1 s con GPU).
# embedding: sin LLM; usarlo en maquinas sin GPU. Es tambien el respaldo automatico.
ROUTER_MODE=llm

# --- Chat: memoria de la conversacion ---
CHAT_HISTORY_MAX_TOKENS=6000
CHAT_HISTORY_ANSWER_CHARS=600

# --- Reranking (cross-encoder via FastEmbed) ---
RERANK_ENABLED=True
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANK_CANDIDATES=20

# --- Almacenamiento de documentos ---
STORAGE_DIR=storage
MAX_UPLOAD_MB=20

# --- Descarga de formatos por QR ---
# Direccion con la que el celular del estudiante llega al backend; va dentro del QR.
# localhost solo sirve para probar en esta maquina: en el quiosco, la IP del servidor
# en la red del campus o el dominio publico que defina TI.
PUBLIC_BASE_URL=http://localhost:8000
DOWNLOAD_LINK_TTL_MINUTES=15
# Firma de los enlaces. Vacio = uno aleatorio por arranque. En produccion, uno largo y fijo.
DOWNLOAD_SECRET=

# Temperatura de las respuestas del chat (0 = siempre igual; Ollama usa 0.8 por defecto).
LLM_TEMPERATURE=0.1

# --- Formatos en OneDrive (opcional) ---
# Vacio: sin subida automatica; el enlace publico se pega a mano en el mantenedor.
# app: cuenta institucional (registro en Entra con permiso Files.ReadWrite.All de aplicacion).
# user: cuenta personal; tras configurar, ejecutar `python -m scripts.onedrive_login` desde backend/.
ONEDRIVE_MODE=
ONEDRIVE_TENANT_ID=consumers
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_DRIVE_USER=
ONEDRIVE_FOLDER=Sara/Formatos

# --- Procesamiento / chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- CORS: origenes del frontend Angular (formato JSON) ---
BACKEND_CORS_ORIGINS=["http://localhost:4200"]
