# Variables del docker compose. Copiar a .env y ajustar.
#   copy .env.example .env

# Modelo de chat: es decision de cada maquina, tiene que estar descargado en el
# Ollama del host ("ollama list" para ver cuales hay).
LLM_MODEL=llama3.1:8b

# PostgreSQL dentro del compose. Solo se usan aqui, no hay que crear nada a mano.
POSTGRES_DB=mini_rag_lab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
