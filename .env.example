# Variables del docker compose. Copiar a .env y ajustar.
#   copy .env.example .env

# Modelo de chat: es decision de cada maquina, tiene que estar descargado en el
# Ollama del host ("ollama list" para ver cuales hay).
LLM_MODEL=llama3.1:8b

# PostgreSQL dentro del compose. Solo se usan aqui, no hay que crear nada a mano.
POSTGRES_DB=mini_rag_lab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Login del mantenedor. Generar el hash con `python -m scripts.hash_password` desde backend/.
# Va entre comillas simples: el hash lleva `$` y docker compose los interpretaria como variables.
ADMIN_PASSWORD_HASH=''
# Firma de las sesiones: una cadena larga y fija. Vacia, reiniciar el backend cierra las sesiones.
AUTH_SECRET=
# Opcional: si se define, el quiosco debe enviar la cabecera X-Kiosk-Key con este valor.
KIOSK_API_KEY=
